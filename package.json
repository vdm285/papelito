{
  "name": "papelito",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Papelito — la lista del súper en una hoja que dos teléfonos comparten. A shared shopping list that behaves like one piece of paper on two phones: end-to-end encrypted, no accounts, no server of our own.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5178 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "icons": "node tools/build-icons.mjs",
    "live": "node tools/sync-live.mjs",
    "smoke": "node tools/smoke.mjs",
    "shots": "node tools/shots.mjs",
    "lf": "node tools/lf.mjs",
    "fonts": "python -I tools/build-fonts.py"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.34.5",
    "vite": "^6.4.5",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0"
  },
  "dependencies": {
    "@noble/secp256k1": "^3.2.0",
    "lit": "^3.3.3",
    "uqr": "^0.1.3"
  }
}
